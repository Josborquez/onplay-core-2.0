# onplay-core 2.0 — variables de entorno (10-SDD §9). En producción se cargan desde el panel de
# Hostinger (Web App → Variables de entorno); en desarrollo desde este archivo copiado a .env.
# NO poner NODE_ENV en el panel: npm lo lee en el install y omite las devDependencies (R-019).
# PORT no existe en la Web App (LiteSpeed Node escucha en un socket); en local se usa 3010.
DATABASE_URL="mysql://usuario:clave@localhost:3306/onplay_core"
JWT_SECRET=
JWT_EXPIRA=8h
REFRESH_EXPIRA=30d

# Admin inicial (§5.4): solo se usa si no hay ningún usuario activo. Contraseña de un solo uso.
ADMIN_INICIAL_EMAIL=
ADMIN_INICIAL_PASSWORD=

# WooCommerce — candado SYNC_SOLO_LECTURA=true hasta la Fase 0 de E3
WOO_ONPLAY_URL=https://onplay.cl
WOO_ONPLAY_CK=
WOO_ONPLAY_CS=
WOO_ONPLAYGAMES_URL=https://onplaygames.cl
WOO_ONPLAYGAMES_CK=
WOO_ONPLAYGAMES_CS=
SYNC_SOLO_LECTURA=true
SYNC_HABILITADO=true
SYNC_CRON="*/30 * * * *"
SYNC_CRON_COMPLETA="*/15 * * * *"
SYNC_LOTE=50
SYNC_CONCURRENCIA=4
SYNC_UBICACION_ONLINE=bodega
SYNC_VENTANA_INGESTA_MIN=20
ALERTA_DISCREPANCIAS=25

# Respaldo lógico desde la app (§5.6): hora Chile; vacío desactiva el automático.
RESPALDO_CRON="0 3 * * *"
RESPALDO_RETENCION=7

# Vacío en producción (mismo origen).
CORS_ORIGINS=
