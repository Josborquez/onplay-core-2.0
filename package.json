{
  "name": "onplay-core",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Sistema POS/ERP OnPlay — fuente de verdad de productos, precios, inventario, clientes y ventas. Versión 2.0: un solo paquete desplegable como Web App Node.js de Hostinger.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/api/index.ts",
    "dev:web": "vite",
    "build": "npm run build:web && npm run build:api",
    "build:web": "tsc -p tsconfig.web.json --noEmit && vite build",
    "build:api": "tsc -p tsconfig.json --noEmit && node esbuild.config.mjs",
    "start": "node dist/servidor.mjs",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "postinstall": "prisma generate",
    "seed": "tsx prisma/seed.ts",
    "crear-admin": "tsx scripts/crear-admin.ts",
    "renumerar-ind": "tsx scripts/renumerar-ind.ts",
    "prisma:migrate": "prisma migrate dev",
    "prisma:validate": "prisma validate"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@fastify/compress": "^8.0.1",
    "@fastify/cookie": "^11.1.2",
    "@fastify/cors": "^10.0.1",
    "@fastify/jwt": "^9.0.1",
    "@fastify/static": "^10.1.3",
    "@prisma/client": "^5.22.0",
    "argon2": "^0.41.1",
    "dotenv": "^16.4.5",
    "fastify": "^5.1.0",
    "fastify-plugin": "^5.0.1",
    "node-cron": "^4.6.0",
    "pdfjs-dist": "^4.10.38"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "esbuild": "^0.24.2",
    "postcss": "^8.4.49",
    "prisma": "^5.22.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.1.1",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "ulid": "^2.3.0",
    "vite": "^5.4.11",
    "vitest": "^2.1.8"
  }
}
